              { "id": "max", "value": 100 },
              { "id": "min", "value": 0 }
            ]
          }
        ]
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["max", "last"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "app_memory_usage_bytes",
          "legendFormat": "Process RSS Memory",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "app_memory_usage_percent",
          "legendFormat": "System Memory %",
          "range": true,
